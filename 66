-- 飞行相关变量
local flying = false
local flightSpeed = 1
local bodyVelocity = nil
local humanoid = nil
local rootPart = nil
local camera = workspace.CurrentCamera

-- 更新速度显示
local function updateSpeedDisplay()
	speedLabel.Text = tostring(flightSpeed)
end

-- 获取玩家输入方向（相对于相机）
local function getInputDirection()
	local direction = Vector3.new()
	-- 前后左右
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then
		direction = direction + camera.CFrame.LookVector * Vector3.new(1,0,1)
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then
		direction = direction - camera.CFrame.LookVector * Vector3.new(1,0,1)
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then
		direction = direction - camera.CFrame.RightVector * Vector3.new(1,0,1)
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then
		direction = direction + camera.CFrame.RightVector * Vector3.new(1,0,1)
	end
	-- 上下（空格 / 左Ctrl）
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
		direction = direction + Vector3.new(0, 1, 0)
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
		direction = direction - Vector3.new(0, 1, 0)
	end
	-- 归一化
	if direction.Magnitude > 0 then
		direction = direction.Unit
	end
	return direction
end

-- 开启/关闭飞行
local function setFlying(enable)
	if enable then
		-- 确保有角色
		local character = waitForCharacter()
		humanoid = character:WaitForChild("Humanoid")
		rootPart = character:WaitForChild("HumanoidRootPart")
		
		-- 如果已有BodyVelocity，先移除
		if bodyVelocity then
			bodyVelocity:Destroy()
		end
		
		-- 创建BodyVelocity
		bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.MaxForce = Vector3.new(4000, 4000, 4000)  -- 足够大的力
		bodyVelocity.Velocity = Vector3.new()
		bodyVelocity.P = 10000  -- 响应速度
		bodyVelocity.Parent = rootPart
		
		-- 设置角色状态（防止行走动画干扰）
		humanoid.PlatformStand = true
		humanoid.AutoRotate = false
		
		-- 每帧更新速度向量
		local heartbeatConn
		heartbeatConn = RunService.Heartbeat:Connect(function()
			if not flying or not bodyVelocity or not rootPart or not rootPart.Parent then
				heartbeatConn:Disconnect()
				return
			end
			local dir = getInputDirection()
			bodyVelocity.Velocity = dir * flightSpeed
		end)
		
		flying = true
	else
		-- 关闭飞行
		if bodyVelocity then
			bodyVelocity:Destroy()
			bodyVelocity = nil
		end
		if humanoid then
			humanoid.PlatformStand = false
			humanoid.AutoRotate = true
		end
		flying = false
	end
end

-- 当角色重生时重新初始化
local function onCharacterAdded(character)
	-- 如果飞行已开启，需要重新应用
	if flying then
		-- 等待部件加载
		humanoid = character:WaitForChild("Humanoid")
		rootPart = character:WaitForChild("HumanoidRootPart")
		setFlying(true)  -- 重新创建BodyVelocity
	end
end

player.CharacterAdded:Connect(onCharacterAdded)

-- 处理角色移除（可选）
local function onCharacterRemoving()
	if bodyVelocity then
		bodyVelocity:Destroy()
		bodyVelocity = nil
	end
end
if player.Character then
	player.Character.AncestryChanged:Connect(function()
		if not player.Character then
			onCharacterRemoving()
		end
	end)
end

